# Copy to .env.local and fill in.

# Postgres. Local development uses the Homebrew server; production uses Neon.
DATABASE_URL=postgresql://localhost:5432/oursnow_dev

# Signs the participant cookie. Any long random string; changing it signs
# every existing participant out, which is a real event, not a config tweak.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The colour the button shows before anybody has voted. A disclosed default,
# not a vote, and the page says so while the tally is empty.
OPENING_COLOUR=blue

# Where confirmation links point. Set it in production; locally and on
# previews it works this out on its own.
# SITE_URL=https://oursnow.co

# ---------------------------------------------------------------------------
# THE EMAIL STEP
#
# All four below are required together. Missing any one and the email box is
# not rendered at all — an address needs somebody answerable for it, a way to
# reach that person, and a way to send the link that proves the address is
# really the visitor's.
# ---------------------------------------------------------------------------

# Who is legally responsible for the personal data. A real person or entity,
# as it would be written on a notice. This is a decision, not a setting.
# Example: Rado Sukala, Prague, Czechia
DATA_CONTROLLER=

# Where a person writes to see, correct, export or erase what is held about
# them. It must be an address that is actually read.
# Example: privacy@oursnow.co
DATA_CONTROLLER_EMAIL=

# Resend, for the one confirmation message. The sending domain has to be
# verified in Resend before anything leaves.
RESEND_API_KEY=
MAIL_FROM=OURS <hello@oursnow.co>
