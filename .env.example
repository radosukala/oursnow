# Copy to .env.local and fill in.

# Postgres. Local development uses the Homebrew server; production uses Neon.
DATABASE_URL=postgresql://localhost:5432/oursnow_dev

# Signs the participant cookie. Any long random string; changing it signs
# every existing participant out, which is a real event, not a config tweak.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The colour the button shows before anybody has voted. A disclosed default,
# not a vote, and the page says so while the tally is empty.
OPENING_COLOUR=blue

# WHO IS LEGALLY RESPONSIBLE FOR PERSONAL DATA.
# The email step stays switched off until this names a real person or entity.
# It is a founder decision, not a configuration convenience: whoever is named
# here is the controller for every address the app holds.
# Example: "Rado Sukala, Prague — rado@example.com"
DATA_CONTROLLER=
